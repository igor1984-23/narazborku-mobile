# Keystore НЕ в git. Скопируй этот файл в android/keystore.properties
# и заполни значения под свой машинный путь.
#
#   cp android/keystore.properties.example android/keystore.properties
#
# Либо задай переменные окружения (имеют приоритет):
#   export NARAZBORKU_KEYSTORE=/path/to/release.keystore
#   export NARAZBORKU_STORE_PASSWORD=...
#   export NARAZBORKU_KEY_PASSWORD=...
#   export NARAZBORKU_KEY_ALIAS=narazborku

# Путь к release-keystore (тот же, которым подписан APK на narazborku.ru)
NARAZBORKU_KEYSTORE=C:/Users/iaraf/.android/release.keystore

# Alias ключа внутри keystore
NARAZBORKU_KEY_ALIAS=narazborku

# Пароли. ВАЖНО: этот файл не коммитится (в .gitignore).
NARAZBORKU_STORE_PASSWORD=
NARAZBORKU_KEY_PASSWORD=
